on early-init
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules q6_pdr_dlkm q6_notifier_dlkm snd_event_dlkm apr_dlkm adsp_loader_dlkm q6_dlkm native_dlkm pinctrl_wcd_dlkm pinctrl_lpi_dlkm platform_dlkm hdmi_dlkm stub_dlkm wcd_core_dlkm bolero_cdc_dlkm va_macro_dlkm rx_macro_dlkm tx_macro_dlkm machine_dlkm

# create data/gps for GPS
on post-fs-data
    mkdir /data/vendor 0771 system system
    chown system system /data/vendor
    mkdir /data/vendor/gps 0771 system system
    chown system system /data/vendor/gps

on boot
#Performance
    chown root system /sys/class/devfreq/soc:qcom,cpu4-cpu-ddr-latfloor/min_freq
    chmod 0664 /sys/class/devfreq/soc:qcom,cpu4-cpu-ddr-latfloor/min_freq
    chown root system /dev/cpuset/restricted/cpus
    chmod 0664 /dev/cpuset/restricted/cpus
    write /dev/cpuset/foreground/cpus 0-2,4-7
    write /dev/cpuset/system-background/cpus 0-2

# SWAP
on boot
    write /proc/sys/vm/page-cluster 0

# Heap: sm7325-common/init.target.rc sets heapgrowthlimit 512m for
# vendor.display.lcd_density=640 (phone panels). The tablet reports 640 as well
# (fb width 1600, real density 340). Zygote starts before early-boot, so after a
# normal boot apps get the build.prop value, but after a framework restart they
# would get 512m. This file is imported after init.target.rc, so this action
# runs later and restores the build.prop value. Keep in sync with
# dalvik.vm.heapgrowthlimit in device.mk.
on property:vendor.display.lcd_density=640
    setprop dalvik.vm.heapgrowthlimit 192m
