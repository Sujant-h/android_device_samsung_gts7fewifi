# Audio
ro.config.media_vol_steps=30
ro.audio.monitorRotation=true

# Bluetooth
bluetooth.device.default_name=Galaxy Tab S7 FE

# Display Orientation
# The natural orientation is the panel's native portrait (1600x2560), as on
# stock. Sensor axes, camera orientation, touch and recovery rotation all rely
# on it, so do not set ro.surface_flinger.primary_display_orientation.
ro.bootanim.set_orientation_logical_0=ORIENTATION_90

# RIL
persist.vendor.radio.atfwd.start=false
ro.radio.noril=yes
ro.carrier=wifi-only
